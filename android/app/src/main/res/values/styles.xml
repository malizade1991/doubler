<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown before the first Flutter frame: mirrors the scaffold color
         (values/colors.xml + values-night) so launch never flashes white. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Material.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Material.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
